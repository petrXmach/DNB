<Window x:Class="DNBridge.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DNBridge.Wpf"
        mc:Ignorable="d"
        Title="DNBridge Monitor" Height="820" Width="960"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Buttons -->
            <RowDefinition Height="Auto"/>   <!-- 1: Status -->
            <RowDefinition Height="*"/>      <!-- 2: Main TabControl -->
            <RowDefinition Height="Auto"/>   <!-- 3: Log label -->
            <RowDefinition Height="130"/>    <!-- 4: Log TextBox -->
        </Grid.RowDefinitions>

        <!-- Control Buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="StartButton" Content="START" Width="100" Height="28" Margin="0,0,10,0" Click="StartButton_Click"/>
            <Button x:Name="StopButton"  Content="STOP"  Width="100" Height="28" Margin="0,0,16,0" Click="StopButton_Click" IsEnabled="False"/>

            <!-- Data source: live SCADA vs. snapshot replay (chosen before START) -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="8,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Source:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="LiveModeRadio"   Content="Live SCADA" GroupName="Mode"
                                 IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Checked="ModeRadio_Changed"/>
                    <RadioButton x:Name="ReplayModeRadio" Content="Replay"     GroupName="Mode"
                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                 Checked="ModeRadio_Changed"/>
                    <TextBox x:Name="ReplayFileBox" Width="240" Height="22" VerticalContentAlignment="Center"
                             IsReadOnly="True" IsEnabled="False" Margin="0,0,6,0"
                             ToolTip="Snapshot file to replay"/>
                    <Button x:Name="BrowseReplayButton" Content="Browse…" Width="70" Height="24"
                            IsEnabled="False" Margin="0,0,6,0" Click="BrowseReplayButton_Click"/>
                    <Button x:Name="InjectReplayButton" Content="Inject" Width="70" Height="24"
                            IsEnabled="False" Click="InjectReplayButton_Click"
                            ToolTip="Re-apply the loaded snapshot to the cache"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Status -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="IsRunningCheckBox"     Content="Is Running"     IsEnabled="False" Margin="0,0,20,0"/>
            <CheckBox x:Name="IsDncConnectedCheckBox"  Content="DNC Connected"  IsEnabled="False" Margin="0,0,20,0"/>
            <CheckBox x:Name="IsScadaConnectedCheckBox" Content="SCADA Connected" IsEnabled="False" Margin="0,0,30,0"/>

            <!-- Opens the an3f4w calc-engine test window (basic DLL probe + per-kind calc tests) -->
            <Button x:Name="DllTestButton" Content="DLL TEST" Width="120" Height="24"
                    Margin="0,0,10,0" Click="DllTestButton_Click"/>
        </StackPanel>

        <!-- Main TabControl: DNC Traffic / SCADA Traffic / Elements -->
        <TabControl Grid.Row="2">

            <!-- DNC Traffic tab: master/detail, both directions (RX = from DNC, TX = to DNC) -->
            <TabItem Header="DNC Traffic">
                <local:TrafficLogView x:Name="DncTrafficView"/>
            </TabItem>

            <!-- SCADA Traffic tab: master/detail, both directions (RX = from SCADA, TX = to SCADA) -->
            <TabItem Header="SCADA Traffic">
                <local:TrafficLogView x:Name="ScadaTrafficView"/>
            </TabItem>

            <!-- Elements tab with three sub-tabs -->
            <TabItem Header="Elements">
                <TabControl>

                    <!-- Monitor elements -->
                    <TabItem x:Name="MonitorTab" Header="Monitor">
                        <DataGrid x:Name="MonitorGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F4F8FF"
                                  FontFamily="Consolas"
                                  FontSize="11">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CA"        Binding="{Binding CA}"          Width="50"/>
                                <DataGridTextColumn Header="IOA"       Binding="{Binding IOA}"         Width="65"/>
                                <DataGridTextColumn Header="Schema ID" Binding="{Binding SchemaId}"    Width="85"/>
                                <DataGridTextColumn Header="Type"      Binding="{Binding TypeName}"    Width="80"/>
                                <DataGridTextColumn Header="Value"     Binding="{Binding ValueText}"   Width="110"/>
                                <DataGridTextColumn Header="Quality"   Binding="{Binding QualityText}" Width="70"/>
                                <DataGridTextColumn Header="Updated"   Binding="{Binding UpdatedText}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Main104 regulation elements -->
                    <TabItem x:Name="Main104Tab" Header="Main104">
                        <DataGrid x:Name="Main104Grid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F4FFF4"
                                  FontFamily="Consolas"
                                  FontSize="11">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"      Binding="{Binding Name}"        Width="*"/>
                                <DataGridTextColumn Header="Direction" Binding="{Binding Direction}"   Width="75"/>
                                <DataGridTextColumn Header="CA"        Binding="{Binding CA}"          Width="50"/>
                                <DataGridTextColumn Header="IOA"       Binding="{Binding IOA}"         Width="65"/>
                                <DataGridTextColumn Header="Value"     Binding="{Binding ValueText}"   Width="110"/>
                                <DataGridTextColumn Header="Updated"   Binding="{Binding UpdatedText}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Setpoint / command elements -->
                    <TabItem x:Name="SetpointsTab" Header="Setpoints">
                        <DataGrid x:Name="SetpointsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#FFFFF4"
                                  FontFamily="Consolas"
                                  FontSize="11">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CA"         Binding="{Binding CA}"           Width="50"/>
                                <DataGridTextColumn Header="IOA"        Binding="{Binding IOA}"          Width="65"/>
                                <DataGridTextColumn Header="Schema ID"  Binding="{Binding SchemaId}"     Width="85"/>
                                <DataGridTextColumn Header="Last Value" Binding="{Binding PokeValueText}" Width="110"/>
                                <DataGridTextColumn Header="Type"       Binding="{Binding PokeType}"     Width="70"/>
                                <DataGridTextColumn Header="Sent At"    Binding="{Binding SentAtText}"   Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                </TabControl>
            </TabItem>

        </TabControl>

        <!-- Log -->
        <TextBlock Grid.Row="3" Text="Log" FontWeight="Bold" FontSize="14" Margin="0,8,0,4"/>
        <TextBox Grid.Row="4" x:Name="LogTextBox"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 Background="#F0F0F0"/>
    </Grid>
</Window>
