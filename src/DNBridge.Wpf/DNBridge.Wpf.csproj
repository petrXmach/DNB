<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- an3f4w.dll (via DNBridge.Calc) is x64-only — force a 64-bit process.
         PlatformTarget (not Platforms) keeps the project on the solution's "Any CPU"
         platform while still emitting an x64 apphost. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DNBridge\DNBridge.csproj" />
    <ProjectReference Include="..\DNBridge.Calc\DNBridge.Calc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TEMPORARY: Main104 mapping for the traffic-loop test. Remove together with
         the XChng.cfg loader after Stage-1 migration. PreserveNewest keeps a
         hand-edited output copy unless the source file is changed. -->
    <None Include="XChng.cfg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
