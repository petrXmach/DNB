<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DNBridge.Calc</RootNamespace>
    <!-- an3f4w.dll is x64-only (Delphi engine); force a 64-bit process in any host.
         PlatformTarget (not Platforms) is the real switch — keeping the project on the
         solution's "Any CPU" platform avoids a config mismatch in DNBridge.slnx. -->
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Native engine + its Borland memory-manager dependency (Native/, alongside the interop
       code that loads them — see Native/NativeLoader.cs). borlndmm.dll MUST be loadable (the
       engine allocates returned strings from its heap). These flow to the output of every
       referencing host, so the published folder is self-contained.
       TargetPath puts them at the output ROOT (next to the exe) — the loader resolves both
       from AppContext.BaseDirectory. Windows-only artifacts: copied only on Windows builds. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="Native\an3f4w.dll">
      <TargetPath>an3f4w.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Native\borlndmm.dll">
      <TargetPath>borlndmm.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Future Linux engine build: drop liban3f4w.so into Native\ and enable this.
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="Native\liban3f4w.so">
      <TargetPath>liban3f4w.so</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  -->


</Project>
